# ============================================
# MCForge Daemon - Configuração do Ambiente
# Copie para .env e preencha
# ============================================

# Porta do painel web (interface do daemon)
DAEMON_PORT=3000

# Chave secreta para JWT (mude isso!)
JWT_SECRET=minha-chave-secreta-mude-aqui-123

# A senha mestre é definida no PRIMEIRO LOGIN pelo painel.
# Portanto, não há senha aqui — defina uma forte ao acessar http://localhost:3000

# Diretório onde os servidores serão criados
SERVERS_DIR=./servers

# Diretório de backups
BACKUPS_DIR=../backups

# Auto restart: se true, reinicia o servidor se ele travar
AUTO_RESTART=true

# Intervalo de verificação em segundos
HEARTBEAT_INTERVAL=30

# Cloudflare Tunnel: caminho para o executável cloudflared
# Deixe vazio se não for usar Tunnel
CLOUDFLARED_PATH=cloudflared

# Domínio do tunnel (se configurado)
TUNNEL_DOMAIN=

# Caminho do Java (deixe vazio para auto-detect)
JAVA_PATH=

# Habilitar logs detalhados
DEBUG=false